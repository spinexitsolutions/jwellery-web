generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Key/value store for site settings, theme, navigation, integrations. Value is JSON.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// CMS page made of ordered sections (JSON array of { id, type, hidden, data }).
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  sections       String   @default("[]")
  seoTitle       String?
  seoDescription String?
  published      Boolean  @default(true)
  showInNav      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String?
  description String?
  image       String?
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  sku              String?
  shortDescription String?
  description      String?
  price            Float
  compareAtPrice   Float?
  images           String      @default("[]") // JSON string[]
  metal            String?
  purity           String?
  gemstone         String?
  weight           String?
  details          String      @default("[]") // JSON {label,value}[]
  tags             String?
  stock            Int         @default(10)
  featured         Boolean     @default(false)
  published        Boolean     @default(true)
  sortOrder        Int         @default(0)
  collectionId     String?
  collection       Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// JSON PricingConfig — variants (metal / size / quality) and live-rate pricing.
  pricing          String      @default("{}")
  certificateLab   String?
  certificateNo    String?
  certificateUrl   String?
  huid             String?
  hsnCode          String?     @default("7113")
  tryAtHome        Boolean     @default(true)
  reviews          Review[]
  wishlistedBy     WishlistItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @default("")
  coverImage  String?
  author      String?
  category    String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  number          String   @unique
  customerName    String
  email           String
  phone           String
  address         String // JSON
  items           String // JSON
  subtotal        Float
  shipping        Float    @default(0)
  total           Float
  status          String   @default("pending") // pending | confirmed | shipped | delivered | cancelled
  paymentMethod   String   @default("cod") // cod | razorpay
  paymentStatus   String   @default("unpaid") // unpaid | paid | failed | refunded
  razorpayOrderId String?
  paymentId       String?
  notes           String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponCode      String?
  discount        Float    @default(0)
  giftWrap        Boolean  @default(false)
  giftWrapFee     Float    @default(0)
  giftMessage     String?
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  invoiceNumber   String?  @unique
  /// Random key that lets a guest open their order page / invoice from emails.
  accessKey       String?
  courier         String?
  awb             String?
  trackingUrl     String?
  shipmentId      String?
  /// JSON [{ status, note, at }] — order timeline shown to the customer.
  timeline        String   @default("[]")
  returns         ReturnRequest[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Customer {
  id        String         @id @default(cuid())
  email     String?        @unique
  phone     String?        @unique
  name      String?
  orders    Order[]
  addresses Address[]
  wishlist  WishlistItem[]
  reviews   Review[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model OtpCode {
  id         String   @id @default(cuid())
  identifier String // email or phone
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  type        String    @default("percent") // percent | flat
  value       Float
  minOrder    Float     @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model ReturnRequest {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String   @default("return") // return | exchange
  reason     String
  details    String?
  items      String   @default("[]") // JSON item names/qty
  status     String   @default("requested") // requested | approved | rejected | picked_up | refunded | exchanged | closed
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  email      String?
  rating     Int
  title      String?
  body       String
  verified   Boolean   @default(false)
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
}

model Store {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  phone     String?
  email     String?
  hours     String?
  image     String?
  lat       Float?
  lng       Float?
  mapUrl    String?
  services  String   @default("store") // comma separated: store,tryathome,video
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  appointments Appointment[]
  createdAt DateTime @default(now())
}

model Appointment {
  id          String   @id @default(cuid())
  type        String // store | home | video
  name        String
  email       String
  phone       String
  date        String // YYYY-MM-DD
  slot        String
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  address     String?
  pincode     String?
  products    String?
  notes       String?
  status      String   @default("requested") // requested | confirmed | completed | cancelled
  meetingLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  type      String   @default("contact") // contact | appointment | product
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new") // new | read | replied | archived
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  name      String
  type      String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  hash       String    @unique
  scopes     String    @default("read") // comma separated: read,write
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}
