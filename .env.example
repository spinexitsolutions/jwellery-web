# Database (SQLite by default — switch provider in prisma/schema.prisma for Postgres/MySQL)
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin sessions
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account created by `npm run setup`
ADMIN_EMAIL="admin@kaaya.in"
ADMIN_PASSWORD="admin12345"

# Public URL of the site (used in customer emails / SMS links)
SITE_URL="http://localhost:3000"

# Where uploaded media is stored on disk
UPLOAD_DIR="./uploads"
